{
  "name": "pocket-galaxy",
  "version": "1.0.0",
  "private": true,
  "description": "Pocket Galaxy \u2014 PocketJS showcase game, PJOS performance and input probe",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "tsc --noEmit && node scripts/check-native-controls.mjs",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:interaction": "node tests/interaction/run-all.mjs",
    "evidence": "node scripts/evidence.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check:assets": "node scripts/check-asset-version.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:assets && npm run test:interaction"
  },
  "devDependencies": {
    "esbuild": "0.27.1",
    "puppeteer-core": "24.31.0",
    "typescript": "5.9.3"
  }
}
